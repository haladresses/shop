generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  SELLER
  STAFF
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIAL
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  BANK_TRANSFER
  CARD
  CASH
  THAWANI
  STRIPE
}

enum OrderSource {
  ONLINE
  POS
}

enum InventoryTxType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  TRANSFER
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum AttributeType {
  TEXT
  NUMBER
  SELECT
  MULTISELECT
  COLOR
  BOOLEAN
}

enum ShippingMethod {
  STANDARD
  WASELLEE
  STORE_PICKUP
}

enum WaselleeDeliveryType {
  HOME_DELIVERY
  OFFICE_PICKUP
}

// ─────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  nameEn       String?
  nameAr       String?
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Per-user adjustments on top of the role: { grant: string[], revoke: string[] }.
  permissionOverrides Json?
  lastLoginAt         DateTime?

  // POS staff PIN login (separate credential from passwordHash — see /pos).
  posPinHash        String?
  posPinAttempts    Int       @default(0)
  posPinLockedUntil DateTime?

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  wishlist      Wishlist[]
  notifications Notification[]
  sessions      Session[]
  products      Product[]      @relation("SellerProducts")
  auditLogs     AuditLog[]
  backups       Backup[]
  posSales      Order[]        @relation("PosCashier")
  posShifts     PosShift[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─────────────────────────────────────────────
// CATEGORIES
// ─────────────────────────────────────────────

model Category {
  id        String     @id @default(cuid())
  nameEn    String
  nameAr    String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children  Category[] @relation("SubCategories")
  image     String?
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  products   Product[]
  attributes CategoryAttribute[]

  @@map("categories")
}

// ─────────────────────────────────────────────
// CATEGORY ATTRIBUTES (dynamic per-category specs)
// ─────────────────────────────────────────────

model CategoryAttribute {
  id           String        @id @default(cuid())
  categoryId   String
  key          String
  labelEn      String
  labelAr      String
  type         AttributeType @default(TEXT)
  options      Json? // [{ value, labelEn, labelAr, hex? }] for SELECT/MULTISELECT/COLOR
  unit         String? // e.g. "cm", "kg"
  placeholder  String?
  isRequired   Boolean       @default(false)
  isFilterable Boolean       @default(false)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, key])
  @@index([categoryId])
  @@map("category_attributes")
}

// ─────────────────────────────────────────────
// PRODUCTS
// ─────────────────────────────────────────────

model Product {
  id            String   @id @default(cuid())
  nameEn        String
  nameAr        String
  descriptionEn String?  @db.Text
  descriptionAr String?  @db.Text
  slug          String   @unique
  categoryId    String
  basePrice     Decimal  @db.Decimal(10, 3)
  salePrice     Decimal? @db.Decimal(10, 3)
  // Purchase/landed cost per unit — feeds COGS, gross profit and stock
  // valuation in the finance & inventory reports. Optional.
  costPrice     Decimal? @db.Decimal(10, 3)
  sku           String?  @unique
  // Barcode for the product itself — used when it has no variants (a variant's
  // own barcode takes precedence when one exists). Scanned at the POS.
  barcode       String?  @unique
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  isNew         Boolean  @default(true)
  isBestSeller  Boolean  @default(false)
  attributes    Json? // { [attributeKey]: value } keyed by CategoryAttribute.key
  sellerId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category        Category                @relation(fields: [categoryId], references: [id])
  seller          User?                   @relation("SellerProducts", fields: [sellerId], references: [id])
  images          ProductImage[]
  variants        ProductVariant[]
  orderItems      OrderItem[]
  reviews         Review[]
  wishlist        Wishlist[]
  whatsappReviews ProductWhatsappReview[]

  @@index([categoryId])
  @@index([sellerId])
  @@index([isActive, createdAt])
  @@index([basePrice])
  @@map("products")
}

model ProductWhatsappReview {
  id           String   @id @default(cuid())
  productId    String
  imageUrl     String
  customerName String?
  caption      String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_whatsapp_reviews")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  altEn     String?
  altAr     String?
  // Ties this image to one of the product's variant colors (matches
  // ProductVariant.color) so the gallery can swap photos when a shopper
  // picks a color. Null/empty means the image applies to every color.
  color     String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id              String  @id @default(cuid())
  productId       String
  color           String?
  colorHex        String?
  // Per-region color breakdown for a single item that is itself multi-color
  // (e.g. yellow sleeves + blue body): [{ part, color, colorHex? }]. `color`/
  // `colorHex` above stay the swatch/label for this option (e.g. "Look 1");
  // this is the detailed breakdown shown to the shopper and the admin.
  colorParts      Json?
  size            String?
  sku             String? @unique
  // Scanned at the POS / printed on shelf labels to identify this exact
  // color+size combination.
  barcode         String? @unique
  priceAdjustment Decimal @default(0) @db.Decimal(10, 3)
  isActive        Boolean @default(true)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  Inventory?
  orderItems OrderItem[]

  @@index([productId])
  @@index([color])
  @@index([size])
  @@map("product_variants")
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String?
  guestEmail      String?
  guestName       String?
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  subtotal        Decimal       @db.Decimal(10, 3)
  shippingCost    Decimal       @default(0) @db.Decimal(10, 3)
  discount        Decimal       @default(0) @db.Decimal(10, 3)
  total           Decimal       @db.Decimal(10, 3)
  couponCode      String?
  notes           String?       @db.Text
  shippingAddress Json

  shippingMethod         ShippingMethod        @default(STANDARD)
  waselleeDeliveryType   WaselleeDeliveryType?
  waselleeBranchId       String?
  waselleeBranch         WaselleeBranch?       @relation(fields: [waselleeBranchId], references: [id])
  whatsappNotifiedAt     DateTime?
  whatsappNotifyError    String?               @db.Text
  // Manual WhatsApp-Web dispatch tracking (set when the admin sends the
  // prepared message to the driver / to Wasli from the order screen).
  driverWhatsappSentAt   DateTime?
  waselleeWhatsappSentAt DateTime?

  // In-store POS sales vs the online storefront; cashierId records which
  // staff member rang up a POS sale (see /pos).
  source         OrderSource @default(ONLINE)
  cashierId      String?
  // POS register shift the sale was rung up in (see PosShift).
  posShiftId     String?
  // Sum of Refund rows for this order (partial or full returns).
  refundedAmount Decimal     @default(0) @db.Decimal(10, 3)
  // Cash tendered / change returned for POS cash sales.
  amountTendered Decimal?    @db.Decimal(10, 3)
  changeGiven    Decimal?    @db.Decimal(10, 3)

  user     User?       @relation(fields: [userId], references: [id])
  cashier  User?       @relation("PosCashier", fields: [cashierId], references: [id])
  posShift PosShift?   @relation(fields: [posShiftId], references: [id])
  items    OrderItem[]
  payments Payment[]
  refunds  Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([waselleeBranchId])
  @@index([cashierId])
  @@index([createdAt])
  @@index([paymentStatus, createdAt])
  @@index([source, createdAt])
  @@index([posShiftId])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String
  variantId       String?
  quantity        Int
  unitPrice       Decimal  @db.Decimal(10, 3)
  // Product cost at the moment of sale, so later cost edits don't rewrite
  // historical profit figures.
  unitCost        Decimal? @db.Decimal(10, 3)
  total           Decimal  @db.Decimal(10, 3)
  productSnapshot Json

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ─────────────────────────────────────────────
// PAYMENTS
// ─────────────────────────────────────────────

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  amount          Decimal       @db.Decimal(10, 3)
  method          PaymentMethod
  status          PaymentStatus @default(UNPAID)
  transactionId   String?
  gatewayResponse Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([createdAt])
  @@map("payments")
}

// ─────────────────────────────────────────────
// WASELLEE SHIPPING
// ─────────────────────────────────────────────

model WaselleeBranch {
  id               String   @id @default(cuid())
  cityEn           String
  cityAr           String
  regionEn         String
  regionAr         String
  phone            String
  homeDeliveryCost Decimal  @default(0) @db.Decimal(10, 3)
  officePickupCost Decimal  @default(0) @db.Decimal(10, 3)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders Order[]

  @@index([regionEn])
  @@map("wasellee_branches")
}

model WaselleeInternationalRate {
  id               String   @id @default(cuid())
  countryEn        String
  countryAr        String
  countryCode      String   @unique
  baseWeightKg     Decimal  @default(1) @db.Decimal(6, 2)
  baseCost         Decimal  @db.Decimal(10, 3)
  additionalKgCost Decimal  @db.Decimal(10, 3)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("wasellee_international_rates")
}

// Singleton row (application reads/creates the first record) holding the
// WhatsApp send configuration. Deliberately DB-backed instead of env vars so
// it is fully editable from the admin Shipping settings screen. Contains a
// secret (wahaApiKey) — only ever exposed through admin-authenticated routes.
model WaselleeSettings {
  id                  String   @id @default(cuid())
  isNotifyEnabled     Boolean  @default(false)
  companyNameEn       String   @default("Wasellee")
  companyNameAr       String   @default("وصلي")
  brandNameEn         String   @default("LO Express")
  website             String?
  instagram           String?
  bousherOfficePhone  String   @default("74186126")
  bousherContactPhone String?
  bousherDriverPhone  String?
  notifyChatId        String? // overrides the derived chat id, e.g. 96874186126@c.us
  wahaBaseUrl         String?
  wahaApiKey          String?
  wahaSession         String   @default("default")
  updatedAt           DateTime @updatedAt

  @@map("wasellee_settings")
}

// ─────────────────────────────────────────────
// INVENTORY
// ─────────────────────────────────────────────

model Inventory {
  id               String   @id @default(cuid())
  variantId        String   @unique
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0)
  lowStockAlert    Int      @default(5)
  location         String?
  updatedAt        DateTime @updatedAt

  variant      ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  transactions InventoryTransaction[]

  @@index([quantity])
  @@map("inventory")
}

model InventoryTransaction {
  id           String          @id @default(cuid())
  inventoryId  String
  type         InventoryTxType
  quantity     Int
  note         String?
  // Supplier invoice / order number / etc. the movement belongs to.
  reference    String?
  // Unit cost for PURCHASE movements (stock receiving).
  unitCost     Decimal?        @db.Decimal(10, 3)
  // Stock level right after this movement — makes the ledger readable.
  balanceAfter Int?
  createdBy    String?
  createdAt    DateTime        @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([createdAt])
  @@index([type, createdAt])
  @@map("inventory_transactions")
}

// ─────────────────────────────────────────────
// ADDRESSES
// ─────────────────────────────────────────────

model Address {
  id         String   @id @default(cuid())
  userId     String
  nameEn     String
  nameAr     String?
  phone      String
  city       String
  area       String?
  street     String?
  buildingNo String?
  country    String   @default("OM")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────────────────────────
// COUPONS
// ─────────────────────────────────────────────

model Coupon {
  id        String     @id @default(cuid())
  code      String     @unique
  type      CouponType
  value     Decimal    @db.Decimal(10, 3)
  minOrder  Decimal?   @db.Decimal(10, 3)
  maxUses   Int?
  usedCount Int        @default(0)
  isActive  Boolean    @default(true)
  expiresAt DateTime?
  createdAt DateTime   @default(now())

  @@map("coupons")
}

// ─────────────────────────────────────────────
// REVIEWS
// ─────────────────────────────────────────────

model Review {
  id         String   @id @default(cuid())
  productId  String
  userId     String
  rating     Int
  comment    String?  @db.Text
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
  @@index([productId])
  @@map("reviews")
}

// ─────────────────────────────────────────────
// WISHLIST
// ─────────────────────────────────────────────

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist")
}

// ─────────────────────────────────────────────
// NEWSLETTER
// ─────────────────────────────────────────────

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  source    String? // e.g. "homepage", "shop-details"
  language  String? // "en" | "ar", locale the subscriber signed up in
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

// ─────────────────────────────────────────────
// SETTINGS
// ─────────────────────────────────────────────

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  type      String   @default("string")
  group     String   @default("general")
  labelEn   String?
  labelAr   String?
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  titleEn   String
  titleAr   String
  messageEn String
  messageAr String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// AUDIT LOGS
// ─────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// BACKUPS
// ─────────────────────────────────────────────

enum BackupType {
  MANUAL
  SCHEDULED
}

enum BackupStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

model Backup {
  id            String       @id @default(cuid())
  filename      String       @unique
  sizeBytes     BigInt?
  type          BackupType   @default(MANUAL)
  status        BackupStatus @default(IN_PROGRESS)
  includesFiles Boolean      @default(true)
  errorMessage  String?
  createdById   String?
  createdAt     DateTime     @default(now())
  completedAt   DateTime?

  createdBy User? @relation(fields: [createdById], references: [id])

  @@index([createdAt])
  @@map("backups")
}

model ContactMessage {
  id        String   @id @default(cuid())
  firstName String
  lastName  String?
  subject   String?
  phone     String?
  email     String?
  message   String   @db.Text
  status    String   @default("new") // new | read | archived
  language  String? // "en" | "ar", locale the message was sent in
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

// ─────────────────────────────────────────────
// FINANCE
// ─────────────────────────────────────────────

// Operating expenses (rent, salaries, marketing, …) — subtracted from gross
// profit in the finance report to give net profit.
model Expense {
  id            String   @id @default(cuid())
  category      String
  amount        Decimal  @db.Decimal(10, 3)
  description   String?
  paymentMethod String   @default("CASH")
  reference     String?
  date          DateTime @default(now())
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
  @@index([category])
  @@map("expenses")
}

// Money returned to a customer for a (partial or full) return.
model Refund {
  id        String   @id @default(cuid())
  orderId   String
  amount    Decimal  @db.Decimal(10, 3)
  method    String   @default("CASH")
  reason    String?
  // [{ orderItemId, variantId, productId, quantity, unitPrice, unitCost }]
  items     Json?
  restocked Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
  @@map("refunds")
}

// ─────────────────────────────────────────────
// POS REGISTER SHIFTS
// ─────────────────────────────────────────────

model PosShift {
  id           String    @id @default(cuid())
  cashierId    String
  status       String    @default("OPEN") // OPEN | CLOSED
  openingCash  Decimal   @default(0) @db.Decimal(10, 3)
  // Counted cash in the drawer at close, and what the system expected.
  closingCash  Decimal?  @db.Decimal(10, 3)
  expectedCash Decimal?  @db.Decimal(10, 3)
  // Pay-ins / pay-outs during the shift: [{ type: "IN"|"OUT", amount, reason, at }]
  movements    Json?
  notes        String?
  openedAt     DateTime  @default(now())
  closedAt     DateTime?

  cashier User    @relation(fields: [cashierId], references: [id])
  orders  Order[]

  @@index([cashierId, status])
  @@index([openedAt])
  @@map("pos_shifts")
}
