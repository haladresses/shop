generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  SELLER
  STAFF
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIAL
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  BANK_TRANSFER
  CARD
  CASH
  THAWANI
  STRIPE
  // Value of goods the customer returned in an exchange, applied to the
  // replacement sale (see Refund.exchangeOrderId).
  EXCHANGE_CREDIT
}

enum OrderSource {
  ONLINE
  POS
}

enum InventoryTxType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  TRANSFER
  // Goods sent back to the supplier (debit note) — always outbound.
  PURCHASE_RETURN
}

// How a tax rate behaves on invoices and in the VAT return.
enum TaxType {
  STANDARD // charged at `rate` (Oman: 5%)
  ZERO_RATED // 0%, but still a taxable supply (reported on the return)
  EXEMPT // no VAT, not a taxable supply
  OUT_OF_SCOPE // outside the VAT system entirely
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PromotionType {
  PERCENT_OFF // X% off each qualifying item
  AMOUNT_OFF // X OMR off each qualifying item
  FIXED_PRICE // qualifying items sell at a set price
  BUY_X_GET_Y // buy X, get Y free (or at a % off) — e.g. buy 1 get 2
  MIX_AND_MATCH // any N qualifying items for a set price — e.g. any 3 for 20 OMR
  ORDER_THRESHOLD // spend X on qualifying items, get Y% / Y OMR off them
}

enum PromotionChannel {
  ALL
  ONLINE
  POS
}

enum PromotionScope {
  ALL // every product
  PRODUCTS // the products listed in PromotionTarget
  CATEGORIES // products in the listed categories (incl. sub-categories)
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum AttributeType {
  TEXT
  NUMBER
  SELECT
  MULTISELECT
  COLOR
  BOOLEAN
}

enum ShippingMethod {
  STANDARD
  WASELLEE
  STORE_PICKUP
}

enum WaselleeDeliveryType {
  HOME_DELIVERY
  OFFICE_PICKUP
}

// ─────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  nameEn       String?
  nameAr       String?
  // Account type. Mirrors `appRole.type` whenever a role is assigned, so code
  // that only cares about the kind of account (staff, seller, customer) keeps working.
  role         Role     @default(CUSTOMER)
  // The role that grants this user's permissions (see AppRole). Null falls back
  // to the built-in role matching `role`. Restrict: a role in use can't be
  // deleted without moving its members to another role first.
  roleId       String?
  appRole      AppRole? @relation("UserAppRole", fields: [roleId], references: [id], onDelete: Restrict)
  isActive     Boolean  @default(true)
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Per-user adjustments on top of the role: { grant: string[], revoke: string[] }.
  permissionOverrides Json?
  lastLoginAt         DateTime?

  // POS staff PIN login (separate credential from passwordHash — see /pos).
  posPinHash        String?
  posPinAttempts    Int       @default(0)
  posPinLockedUntil DateTime?

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  wishlist      Wishlist[]
  notifications Notification[]
  sessions      Session[]
  products      Product[]      @relation("SellerProducts")
  auditLogs     AuditLog[]
  backups       Backup[]
  posSales      Order[]        @relation("PosCashier")
  posShifts     PosShift[]
  supplierTasks SupplierTask[] @relation("SupplierTaskAssignee")
  rolesCreated  AppRole[]      @relation("AppRoleCreator")

  @@index([roleId])
  @@map("users")
}

// A named set of permissions given to users. The five built-in roles
// (isSystem: super_admin, admin, staff, seller, customer) can't be deleted;
// super admin always has every permission. Any number of custom roles can be added.
model AppRole {
  id          String   @id @default(cuid())
  key         String   @unique
  nameEn      String
  nameAr      String?
  description String?
  color       String   @default("#64748b")
  // The account type users get when this role is assigned (written to User.role).
  // SUPER_ADMIN is reserved for the built-in super admin role.
  type        Role     @default(STAFF)
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  // Seniority: people can only manage users and roles ranked below their own.
  rank        Int      @default(10)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("AppRoleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  users User[] @relation("UserAppRole")

  @@index([type])
  @@map("app_roles")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  // Set while the POS screen is locked: the session counts as signed out
  // everywhere until the same person unlocks it with their PIN.
  lockedAt  DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─────────────────────────────────────────────
// CATEGORIES
// ─────────────────────────────────────────────

model Category {
  id        String     @id @default(cuid())
  nameEn    String
  nameAr    String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children  Category[] @relation("SubCategories")
  image     String?
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  // VAT rate for products in this category (and its sub-categories) unless a
  // product sets its own. Null = inherit from the parent / store default.
  taxRateId String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  products         Product[]
  attributes       CategoryAttribute[]
  taxRate          TaxRate?            @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  promotionTargets PromotionTarget[]

  @@map("categories")
}

// ─────────────────────────────────────────────
// CATEGORY ATTRIBUTES (dynamic per-category specs)
// ─────────────────────────────────────────────

model CategoryAttribute {
  id           String        @id @default(cuid())
  categoryId   String
  key          String
  labelEn      String
  labelAr      String
  type         AttributeType @default(TEXT)
  options      Json? // [{ value, labelEn, labelAr, hex? }] for SELECT/MULTISELECT/COLOR
  unit         String? // e.g. "cm", "kg"
  placeholder  String?
  isRequired   Boolean       @default(false)
  isFilterable Boolean       @default(false)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, key])
  @@index([categoryId])
  @@map("category_attributes")
}

// ─────────────────────────────────────────────
// PRODUCTS
// ─────────────────────────────────────────────

model Product {
  id            String             @id @default(cuid())
  nameEn        String
  nameAr        String
  descriptionEn String?            @db.Text
  descriptionAr String?            @db.Text
  slug          String             @unique
  categoryId    String
  basePrice     Decimal            @db.Decimal(10, 3)
  salePrice     Decimal?           @db.Decimal(10, 3)
  // Purchase/landed cost per unit — feeds COGS, gross profit and stock
  // valuation in the finance & inventory reports. Optional.
  costPrice     Decimal?           @db.Decimal(10, 3)
  sku           String?            @unique
  // Barcode for the product itself — used when it has no variants (a variant's
  // own barcode takes precedence when one exists). Scanned at the POS.
  barcode       String?            @unique
  isActive      Boolean            @default(true)
  isFeatured    Boolean            @default(false)
  isNew         Boolean            @default(true)
  isBestSeller  Boolean            @default(false)
  attributes    Json? // { [attributeKey]: value } keyed by CategoryAttribute.key
  // Extra specifications that belong to this product only (not defined on its
  // category): [{ labelEn, labelAr, valueEn, valueAr }]. Shown after the
  // category specifications on the storefront.
  customSpecs   Json?
  sellerId      String?
  // VAT rate override for this product. Null = inherit from its category
  // (then parent categories, then the store default rate).
  taxRateId     String?
  // The supplier this item is normally bought from.
  supplierId    String?
  // Store department (the old POS "Main Category"): who the item is for.
  department    ProductDepartment?
  // Original record from a data import (e.g. the old POS "Product List"
  // export): { source, importedAt, row: { <column>: <value> } }. Read-only,
  // kept so no imported information is lost.
  legacyData    Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  category         Category                @relation(fields: [categoryId], references: [id])
  seller           User?                   @relation("SellerProducts", fields: [sellerId], references: [id])
  taxRate          TaxRate?                @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  supplier         Supplier?               @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  variants         ProductVariant[]
  orderItems       OrderItem[]
  reviews          Review[]
  wishlist         Wishlist[]
  whatsappReviews  ProductWhatsappReview[]
  purchaseItems    PurchaseOrderItem[]
  promotionTargets PromotionTarget[]

  @@index([categoryId])
  @@index([sellerId])
  @@index([supplierId])
  @@index([isActive, createdAt])
  @@index([basePrice])
  @@map("products")
}

// Store department (the old POS "Main Category").
enum ProductDepartment {
  LADIES
  GIRLS
  BOYS
  BABY
  GIFTS
}

model ProductWhatsappReview {
  id           String   @id @default(cuid())
  productId    String
  imageUrl     String
  customerName String?
  caption      String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_whatsapp_reviews")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  altEn     String?
  altAr     String?
  // Ties this image to one of the product's variant colors (matches
  // ProductVariant.color) so the gallery can swap photos when a shopper
  // picks a color. Null/empty means the image applies to every color.
  color     String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id              String  @id @default(cuid())
  productId       String
  color           String?
  colorHex        String?
  // Per-region color breakdown for a single item that is itself multi-color
  // (e.g. yellow sleeves + blue body): [{ part, color, colorHex? }]. `color`/
  // `colorHex` above stay the swatch/label for this option (e.g. "Look 1");
  // this is the detailed breakdown shown to the shopper and the admin.
  colorParts      Json?
  size            String?
  sku             String? @unique
  // Scanned at the POS / printed on shelf labels to identify this exact
  // color+size combination.
  barcode         String? @unique
  priceAdjustment Decimal @default(0) @db.Decimal(10, 3)
  isActive        Boolean @default(true)

  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory     Inventory?
  orderItems    OrderItem[]
  purchaseItems PurchaseOrderItem[]

  @@index([productId])
  @@index([color])
  @@index([size])
  @@map("product_variants")
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String?
  guestEmail      String?
  guestName       String?
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  subtotal        Decimal       @db.Decimal(10, 3)
  shippingCost    Decimal       @default(0) @db.Decimal(10, 3)
  discount        Decimal       @default(0) @db.Decimal(10, 3)
  total           Decimal       @db.Decimal(10, 3)
  couponCode      String?
  notes           String?       @db.Text
  shippingAddress Json

  shippingMethod         ShippingMethod        @default(STANDARD)
  waselleeDeliveryType   WaselleeDeliveryType?
  waselleeBranchId       String?
  waselleeBranch         WaselleeBranch?       @relation(fields: [waselleeBranchId], references: [id])
  whatsappNotifiedAt     DateTime?
  whatsappNotifyError    String?               @db.Text
  // Manual WhatsApp-Web dispatch tracking (set when the admin sends the
  // prepared message to the driver / to Wasli from the order screen).
  driverWhatsappSentAt   DateTime?
  waselleeWhatsappSentAt DateTime?

  // In-store POS sales vs the online storefront; cashierId records which
  // staff member rang up a POS sale (see /pos).
  source         OrderSource @default(ONLINE)
  cashierId      String?
  // POS register shift the sale was rung up in (see PosShift).
  posShiftId     String?
  // Sum of Refund rows for this order (partial or full returns).
  refundedAmount Decimal     @default(0) @db.Decimal(10, 3)
  // Cash tendered / change returned for POS cash sales.
  amountTendered Decimal?    @db.Decimal(10, 3)
  changeGiven    Decimal?    @db.Decimal(10, 3)

  // ── VAT ── (all zero when VAT is switched off)
  // Sequential tax-invoice number (INV-2026-000001) printed on the bill.
  invoiceNumber     String? @unique
  // Whether the item prices on this order already included VAT (snapshot of
  // the store setting at the time of sale).
  pricesIncludeTax  Boolean @default(true)
  // Total VAT on the order, including VAT on shipping.
  taxTotal          Decimal @default(0) @db.Decimal(10, 3)
  // VAT on the shipping fee (part of taxTotal).
  shippingTax       Decimal @default(0) @db.Decimal(10, 3)
  // Per-rate summary for the invoice and the VAT return:
  // [{ code, nameEn, nameAr, rate, type, taxable, tax }]
  taxBreakdown      Json?
  // Customer's own VAT number (B2B tax invoices).
  customerVatNumber String?

  // ── Promotions ── part of `discount`: discount = promotionDiscount + any
  // manual (POS) / coupon discount.
  promotionDiscount Decimal @default(0) @db.Decimal(10, 3)
  // [{ id, nameEn, nameAr, type, discount, units }] — printed on the bill.
  appliedPromotions Json?

  user                 User?                 @relation(fields: [userId], references: [id])
  cashier              User?                 @relation("PosCashier", fields: [cashierId], references: [id])
  posShift             PosShift?             @relation(fields: [posShiftId], references: [id])
  items                OrderItem[]
  payments             Payment[]
  refunds              Refund[]
  promotionRedemptions PromotionRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([waselleeBranchId])
  @@index([cashierId])
  @@index([createdAt])
  @@index([paymentStatus, createdAt])
  @@index([source, createdAt])
  @@index([posShiftId])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String
  variantId       String?
  quantity        Int
  unitPrice       Decimal  @db.Decimal(10, 3)
  // Product cost at the moment of sale, so later cost edits don't rewrite
  // historical profit figures.
  unitCost        Decimal? @db.Decimal(10, 3)
  total           Decimal  @db.Decimal(10, 3)
  productSnapshot Json

  // ── VAT ── The line's share of the order discount, then the amount VAT was
  // charged on and the VAT itself. taxableAmount + taxAmount is what the
  // customer actually paid for the line, which is what a return refunds.
  // taxableAmount is null on orders placed before VAT tracking existed.
  discountAmount    Decimal  @default(0) @db.Decimal(10, 3)
  taxRate           Decimal  @default(0) @db.Decimal(6, 3)
  taxCode           String?
  taxableAmount     Decimal? @db.Decimal(10, 3)
  taxAmount         Decimal  @default(0) @db.Decimal(10, 3)
  // Part of discountAmount that came from promotions.
  promotionDiscount Decimal  @default(0) @db.Decimal(10, 3)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ─────────────────────────────────────────────
// PAYMENTS
// ─────────────────────────────────────────────

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  amount          Decimal       @db.Decimal(10, 3)
  method          PaymentMethod
  status          PaymentStatus @default(UNPAID)
  transactionId   String?
  gatewayResponse Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([createdAt])
  @@map("payments")
}

// ─────────────────────────────────────────────
// WASELLEE SHIPPING
// ─────────────────────────────────────────────

model WaselleeBranch {
  id               String   @id @default(cuid())
  cityEn           String
  cityAr           String
  regionEn         String
  regionAr         String
  phone            String
  homeDeliveryCost Decimal  @default(0) @db.Decimal(10, 3)
  officePickupCost Decimal  @default(0) @db.Decimal(10, 3)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders Order[]

  @@index([regionEn])
  @@map("wasellee_branches")
}

model WaselleeInternationalRate {
  id               String   @id @default(cuid())
  countryEn        String
  countryAr        String
  countryCode      String   @unique
  baseWeightKg     Decimal  @default(1) @db.Decimal(6, 2)
  baseCost         Decimal  @db.Decimal(10, 3)
  additionalKgCost Decimal  @db.Decimal(10, 3)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("wasellee_international_rates")
}

// Singleton row (application reads/creates the first record) holding the
// WhatsApp send configuration. Deliberately DB-backed instead of env vars so
// it is fully editable from the admin Shipping settings screen. Contains a
// secret (wahaApiKey) — only ever exposed through admin-authenticated routes.
model WaselleeSettings {
  id                  String   @id @default(cuid())
  isNotifyEnabled     Boolean  @default(false)
  companyNameEn       String   @default("Wasellee")
  companyNameAr       String   @default("وصلي")
  brandNameEn         String   @default("LO Express")
  website             String?
  instagram           String?
  bousherOfficePhone  String   @default("74186126")
  bousherContactPhone String?
  bousherDriverPhone  String?
  notifyChatId        String? // overrides the derived chat id, e.g. 96874186126@c.us
  wahaBaseUrl         String?
  wahaApiKey          String?
  wahaSession         String   @default("default")
  updatedAt           DateTime @updatedAt

  @@map("wasellee_settings")
}

// ─────────────────────────────────────────────
// INVENTORY
// ─────────────────────────────────────────────

model Inventory {
  id               String   @id @default(cuid())
  variantId        String   @unique
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0)
  lowStockAlert    Int      @default(5)
  location         String?
  updatedAt        DateTime @updatedAt

  variant      ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  transactions InventoryTransaction[]

  @@index([quantity])
  @@map("inventory")
}

model InventoryTransaction {
  id           String          @id @default(cuid())
  inventoryId  String
  type         InventoryTxType
  quantity     Int
  note         String?
  // Supplier invoice / order number / etc. the movement belongs to.
  reference    String?
  // Unit cost for PURCHASE movements (stock receiving).
  unitCost     Decimal?        @db.Decimal(10, 3)
  // Stock level right after this movement — makes the ledger readable.
  balanceAfter Int?
  createdBy    String?
  createdAt    DateTime        @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([createdAt])
  @@index([type, createdAt])
  @@map("inventory_transactions")
}

// ─────────────────────────────────────────────
// ADDRESSES
// ─────────────────────────────────────────────

model Address {
  id         String   @id @default(cuid())
  userId     String
  nameEn     String
  nameAr     String?
  phone      String
  city       String
  area       String?
  street     String?
  buildingNo String?
  country    String   @default("OM")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────────────────────────
// COUPONS
// ─────────────────────────────────────────────

model Coupon {
  id        String     @id @default(cuid())
  code      String     @unique
  type      CouponType
  value     Decimal    @db.Decimal(10, 3)
  minOrder  Decimal?   @db.Decimal(10, 3)
  maxUses   Int?
  usedCount Int        @default(0)
  isActive  Boolean    @default(true)
  expiresAt DateTime?
  createdAt DateTime   @default(now())

  @@map("coupons")
}

// ─────────────────────────────────────────────
// REVIEWS
// ─────────────────────────────────────────────

model Review {
  id         String   @id @default(cuid())
  productId  String
  userId     String
  rating     Int
  comment    String?  @db.Text
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
  @@index([productId])
  @@map("reviews")
}

// ─────────────────────────────────────────────
// WISHLIST
// ─────────────────────────────────────────────

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist")
}

// ─────────────────────────────────────────────
// NEWSLETTER
// ─────────────────────────────────────────────

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  source    String? // e.g. "homepage", "shop-details"
  language  String? // "en" | "ar", locale the subscriber signed up in
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

// ─────────────────────────────────────────────
// SETTINGS
// ─────────────────────────────────────────────

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  type      String   @default("string")
  group     String   @default("general")
  labelEn   String?
  labelAr   String?
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  titleEn   String
  titleAr   String
  messageEn String
  messageAr String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// AUDIT LOGS
// ─────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// BACKUPS
// ─────────────────────────────────────────────

enum BackupType {
  MANUAL
  SCHEDULED
}

enum BackupStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

model Backup {
  id            String       @id @default(cuid())
  filename      String       @unique
  sizeBytes     BigInt?
  type          BackupType   @default(MANUAL)
  status        BackupStatus @default(IN_PROGRESS)
  includesFiles Boolean      @default(true)
  errorMessage  String?
  createdById   String?
  createdAt     DateTime     @default(now())
  completedAt   DateTime?

  createdBy User? @relation(fields: [createdById], references: [id])

  @@index([createdAt])
  @@map("backups")
}

model ContactMessage {
  id        String   @id @default(cuid())
  firstName String
  lastName  String?
  subject   String?
  phone     String?
  email     String?
  message   String   @db.Text
  status    String   @default("new") // new | read | archived
  language  String? // "en" | "ar", locale the message was sent in
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

// ─────────────────────────────────────────────
// FINANCE
// ─────────────────────────────────────────────

// Operating expenses (rent, salaries, marketing, …) — subtracted from gross
// profit in the finance report to give net profit.
model Expense {
  id            String   @id @default(cuid())
  category      String
  amount        Decimal  @db.Decimal(10, 3)
  description   String?
  paymentMethod String   @default("CASH")
  reference     String?
  date          DateTime @default(now())
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
  @@index([category])
  @@map("expenses")
}

// Money returned to a customer for a (partial or full) return.
model Refund {
  id                  String   @id @default(cuid())
  orderId             String
  amount              Decimal  @db.Decimal(10, 3)
  method              String   @default("CASH")
  reason              String?
  // [{ orderItemId, variantId, productId, quantity, unitPrice, unitCost }]
  items               Json?
  restocked           Boolean  @default(true)
  // VAT reversed by this refund (part of `amount`) and its credit-note number.
  taxAmount           Decimal  @default(0) @db.Decimal(10, 3)
  creditNoteNumber    String?  @unique
  // Exchange: the replacement sale this credit was applied to (method "EXCHANGE").
  exchangeOrderId     String?
  exchangeOrderNumber String?
  createdBy           String?
  createdAt           DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
  @@index([exchangeOrderId])
  @@map("refunds")
}

// ─────────────────────────────────────────────
// POS REGISTER SHIFTS
// ─────────────────────────────────────────────

model PosShift {
  id           String    @id @default(cuid())
  cashierId    String
  status       String    @default("OPEN") // OPEN | CLOSED
  openingCash  Decimal   @default(0) @db.Decimal(10, 3)
  // Counted cash in the drawer at close, and what the system expected.
  closingCash  Decimal?  @db.Decimal(10, 3)
  expectedCash Decimal?  @db.Decimal(10, 3)
  // Pay-ins / pay-outs during the shift: [{ type: "IN"|"OUT", amount, reason, at }]
  movements    Json?
  notes        String?
  openedAt     DateTime  @default(now())
  closedAt     DateTime?

  cashier User    @relation(fields: [cashierId], references: [id])
  orders  Order[]

  @@index([cashierId, status])
  @@index([openedAt])
  @@map("pos_shifts")
}

// ─────────────────────────────────────────────
// TAX / VAT
// ─────────────────────────────────────────────

// A VAT rate products and categories can be assigned to. Store-wide VAT
// settings (on/off, VAT number, prices incl./excl. VAT …) live in the
// `tax_settings_v1` Setting row — see lib/tax.ts.
model TaxRate {
  id          String   @id @default(cuid())
  // Short code printed on invoices and used in the VAT report, e.g. "S" / "Z" / "E".
  code        String   @unique
  nameEn      String
  nameAr      String
  // Percentage, e.g. 5.000 for 5%.
  rate        Decimal  @db.Decimal(6, 3)
  type        TaxType  @default(STANDARD)
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products   Product[]
  categories Category[]

  @@map("tax_rates")
}

// Gap-free running counters for document numbers (invoices, credit notes,
// purchase orders, GRNs, supplier payments …). Incremented inside the same
// transaction that creates the document.
model DocumentSequence {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("document_sequences")
}

// ─────────────────────────────────────────────
// SUPPLIERS & PURCHASING
// ─────────────────────────────────────────────

model Supplier {
  id               String   @id @default(cuid())
  code             String   @unique // SUP-0001
  nameEn           String
  nameAr           String?
  category         String? // what they supply, e.g. "Fabrics", "Abayas"
  contactPerson    String?
  phone            String?
  whatsapp         String?
  email            String?
  website          String?
  address          String?  @db.Text
  city             String?
  country          String   @default("OM")
  // Supplier's VAT number — needed to reclaim the input VAT on their invoices.
  vatNumber        String?
  // Commercial registration number.
  crNumber         String?
  // Days after delivery an invoice falls due (0 = cash on delivery).
  paymentTermsDays Int      @default(0)
  creditLimit      Decimal? @db.Decimal(12, 3)
  // Amount already owed to this supplier before it was set up here.
  openingBalance   Decimal  @default(0) @db.Decimal(12, 3)
  bankName         String?
  bankAccountName  String?
  iban             String?
  // 1–5 internal rating (quality / reliability).
  rating           Int?
  notes            String?  @db.Text
  isActive         Boolean  @default(true)
  // Original record from a data import (e.g. the old POS "Supplier" export):
  // { source, importedAt, row: { <column>: <value> } }. Read-only.
  legacyData       Json?
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  payments       SupplierPayment[]
  returns        PurchaseReturn[]
  tasks          SupplierTask[]
  products       Product[]

  @@index([isActive])
  @@index([nameEn])
  @@map("suppliers")
}

// A purchase from a supplier. It becomes money owed (a payable) once it is
// ORDERED; stock goes up as goods are received against it (PurchaseReceipt).
model PurchaseOrder {
  id                String              @id @default(cuid())
  number            String              @unique // PO-2026-0001
  supplierId        String
  status            PurchaseOrderStatus @default(DRAFT)
  // The supplier's own invoice / bill number and date (for the VAT return).
  supplierReference String?
  invoiceDate       DateTime?
  orderDate         DateTime            @default(now())
  expectedDate      DateTime?
  // When payment is due — defaults to delivery date + the supplier's terms.
  dueDate           DateTime?
  orderedAt         DateTime?
  receivedAt        DateTime?
  cancelledAt       DateTime?
  // Whether the line unit costs were entered including VAT.
  pricesIncludeTax  Boolean             @default(false)
  // Σ line amounts excluding VAT, before the order discount.
  subtotal          Decimal             @default(0) @db.Decimal(12, 3)
  discount          Decimal             @default(0) @db.Decimal(12, 3)
  // Freight and other landed costs (customs, clearance …) — VAT-exclusive,
  // spread over the received units' cost.
  shippingCost      Decimal             @default(0) @db.Decimal(12, 3)
  otherCharges      Decimal             @default(0) @db.Decimal(12, 3)
  taxTotal          Decimal             @default(0) @db.Decimal(12, 3)
  total             Decimal             @default(0) @db.Decimal(12, 3)
  // Σ payment allocations against this order.
  amountPaid        Decimal             @default(0) @db.Decimal(12, 3)
  // Σ goods returned to the supplier against this order (debit notes).
  returnedTotal     Decimal             @default(0) @db.Decimal(12, 3)
  notes             String?             @db.Text
  // [{ url, name }] — scanned supplier invoice, delivery note …
  attachments       Json?
  createdBy         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  supplier    Supplier                    @relation(fields: [supplierId], references: [id])
  items       PurchaseOrderItem[]
  receipts    PurchaseReceipt[]
  allocations SupplierPaymentAllocation[]
  returns     PurchaseReturn[]
  tasks       SupplierTask[]

  @@index([supplierId, status])
  @@index([status, dueDate])
  @@index([orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  productId       String?
  // Null for a product without variants until its first delivery, which
  // creates a standard stock record for it.
  variantId       String?
  // Snapshot so the order stays readable if the product is edited / deleted.
  nameEn          String
  nameAr          String?
  variantLabel    String?
  sku             String?
  barcode         String?
  quantity        Int
  receivedQty     Int      @default(0)
  returnedQty     Int      @default(0)
  // As entered (incl. VAT when the order's pricesIncludeTax is on).
  unitCost        Decimal  @db.Decimal(12, 3)
  discountPct     Decimal  @default(0) @db.Decimal(5, 2)
  taxRate         Decimal  @default(0) @db.Decimal(6, 3)
  taxCode         String?
  // After line + order discount: amount excl. VAT and the VAT on it.
  netAmount       Decimal  @default(0) @db.Decimal(12, 3)
  taxAmount       Decimal  @default(0) @db.Decimal(12, 3)
  // Unit cost that goes into stock value: net of discounts, plus its share of
  // freight/charges (plus VAT when VAT can't be reclaimed).
  landedUnitCost  Decimal? @db.Decimal(12, 3)
  sortOrder       Int      @default(0)

  purchaseOrder PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
  @@index([productId])
  @@index([variantId])
  @@map("purchase_order_items")
}

// Goods received note — one per delivery against a purchase order.
model PurchaseReceipt {
  id              String   @id @default(cuid())
  number          String   @unique // GRN-2026-0001
  purchaseOrderId String
  receivedAt      DateTime @default(now())
  // [{ itemId, variantId, nameEn, variantLabel, quantity, unitCost }]
  items           Json
  units           Int
  value           Decimal  @db.Decimal(12, 3)
  note            String?
  createdBy       String?
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([receivedAt])
  @@map("purchase_receipts")
}

// Goods sent back to a supplier (debit note) — reduces stock and what we owe.
model PurchaseReturn {
  id              String   @id @default(cuid())
  number          String   @unique // DN-2026-0001
  supplierId      String
  purchaseOrderId String?
  // [{ itemId, variantId, nameEn, variantLabel, quantity, unitCost, taxRate, net, tax }]
  items           Json
  subtotal        Decimal  @db.Decimal(12, 3)
  taxTotal        Decimal  @db.Decimal(12, 3)
  total           Decimal  @db.Decimal(12, 3)
  reason          String?
  returnedAt      DateTime @default(now())
  createdBy       String?
  createdAt       DateTime @default(now())

  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([supplierId])
  @@index([returnedAt])
  @@map("purchase_returns")
}

// Money paid to a supplier. It's spread over their open purchase orders via
// allocations; anything left unallocated is credit on their account (and
// reduces the balance owed, e.g. against the opening balance).
model SupplierPayment {
  id         String   @id @default(cuid())
  number     String   @unique // SP-2026-0001
  supplierId String
  amount     Decimal  @db.Decimal(12, 3)
  method     String   @default("BANK_TRANSFER") // CASH | BANK_TRANSFER | CHEQUE | CARD | OTHER
  reference  String? // transfer reference / cheque number
  paidAt     DateTime @default(now())
  note       String?
  createdBy  String?
  createdAt  DateTime @default(now())

  supplier    Supplier                    @relation(fields: [supplierId], references: [id])
  allocations SupplierPaymentAllocation[]

  @@index([supplierId, paidAt])
  @@index([paidAt])
  @@map("supplier_payments")
}

model SupplierPaymentAllocation {
  id              String  @id @default(cuid())
  paymentId       String
  purchaseOrderId String
  amount          Decimal @db.Decimal(12, 3)

  payment       SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([purchaseOrderId])
  @@map("supplier_payment_allocations")
}

// Follow-ups for the purchasing team: call a supplier, chase a late
// delivery, pay an invoice by a date …
model SupplierTask {
  id              String       @id @default(cuid())
  supplierId      String?
  purchaseOrderId String?
  title           String
  description     String?      @db.Text
  type            String       @default("TASK") // TASK | CALL | FOLLOW_UP | PAYMENT | DELIVERY | MEETING
  priority        TaskPriority @default(NORMAL)
  status          TaskStatus   @default(OPEN)
  dueDate         DateTime?
  assigneeId      String?
  completedAt     DateTime?
  createdBy       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  assignee      User?          @relation("SupplierTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([status, dueDate])
  @@index([supplierId])
  @@index([assigneeId])
  @@map("supplier_tasks")
}

// ─────────────────────────────────────────────
// PROMOTIONS (automatic deals — no code needed, unlike coupons)
// ─────────────────────────────────────────────

model Promotion {
  id            String           @id @default(cuid())
  nameEn        String
  nameAr        String
  descriptionEn String?          @db.Text
  descriptionAr String?          @db.Text
  // Short label for product cards / receipts, e.g. "Buy 1 Get 2".
  badgeEn       String?
  badgeAr       String?
  type          PromotionType
  channel       PromotionChannel @default(ALL)
  isActive      Boolean          @default(true)
  // Schedule (shop time). Null = open-ended.
  startsAt      DateTime?
  endsAt        DateTime?
  // Days it runs, 0 = Sunday … 6 = Saturday. Null/empty = every day.
  daysOfWeek    Json?
  // Daily window "HH:MM" (shop time), e.g. happy hour. Both null = all day.
  startTime     String?
  endTime       String?
  // Higher runs first; an item can only be used by one item-level deal.
  priority      Int              @default(0)

  // ── Rule parameters (which ones apply depends on `type`) ──
  discountPercent         Decimal? @db.Decimal(5, 2) // PERCENT_OFF, BUY_X_GET_Y reward (100 = free), ORDER_THRESHOLD
  discountAmount          Decimal? @db.Decimal(10, 3) // AMOUNT_OFF, ORDER_THRESHOLD
  fixedPrice              Decimal? @db.Decimal(10, 3) // FIXED_PRICE (per item), MIX_AND_MATCH (per set)
  buyQuantity             Int? // BUY_X_GET_Y: X · MIX_AND_MATCH: N
  getQuantity             Int? // BUY_X_GET_Y: Y
  minSpend                Decimal? @db.Decimal(10, 3) // ORDER_THRESHOLD
  // Max times the deal applies in one order (null = unlimited).
  maxApplicationsPerOrder Int?
  // Max orders that can use it overall (null = unlimited).
  usageLimit              Int?
  usedCount               Int      @default(0)

  // Qualifying items (buy side) and, for BUY_X_GET_Y, the rewarded items
  // (get side — null = the same items as the buy side).
  buyScope         PromotionScope  @default(PRODUCTS)
  getScope         PromotionScope?
  // Skip items that already have a sale price.
  excludeSaleItems Boolean         @default(false)

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  targets     PromotionTarget[]
  redemptions PromotionRedemption[]

  @@index([isActive, startsAt, endsAt])
  @@map("promotions")
}

model PromotionTarget {
  id          String  @id @default(cuid())
  promotionId String
  side        String  @default("BUY") // BUY | GET
  productId   String?
  categoryId  String?

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([productId])
  @@index([categoryId])
  @@map("promotion_targets")
}

// One row per order a promotion was applied to — drives the performance stats.
model PromotionRedemption {
  id          String   @id @default(cuid())
  promotionId String
  orderId     String
  discount    Decimal  @db.Decimal(10, 3)
  units       Int      @default(0)
  createdAt   DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([promotionId, createdAt])
  @@index([orderId])
  @@map("promotion_redemptions")
}
