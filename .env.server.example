# ───────────────────────────────────────────────────────────────
# Hala Dresses — environment template.
# Copy to `.env` (same keys) and fill in real values.
# `.env` is gitignored; this template is committed.
# ───────────────────────────────────────────────────────────────

# ─── Database — local development / Prisma ───
# Used by `prisma generate`, `npm run dev`, and the Prisma CLI locally.
# On the server (Docker), the container builds its own DATABASE_URL from
# the POSTGRES_* values below, so this line is ignored there.
DATABASE_URL="postgresql://USER@localhost/haladresses?host=/var/run/postgresql&schema=public"

# ─── PostgreSQL — Docker / server ───
# Used by docker-compose for the postgres service and to build the app's
# DATABASE_URL (postgresql://USER:PASSWORD@postgres:5432/DB).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=haladresses

# ─── App ───
NEXTAUTH_SECRET="change-this-generate-with: openssl rand -base64 32"
NEXTAUTH_URL="https://hala-dresses.com"
NEXT_PUBLIC_APP_URL="https://hala-dresses.com"
NEXT_PUBLIC_APP_NAME="Hala Dresses"

# ─── Reverse proxy (nginx-proxy + letsencrypt-companion) ───
VIRTUAL_HOST=hala-dresses.com
LETSENCRYPT_HOST=hala-dresses.com
LETSENCRYPT_EMAIL=admin@hala-dresses.com

# ─── First-deploy seed ───
# Set to "true" only on the FIRST deploy to create the admin user
# (admin@haladresses.com / Admin@12345) and demo data, then set back to false.
RUN_SEED=false

# ─── Thawani payment gateway — https://docs.thawani.om ───
# Secret key must NEVER be exposed client-side. Get real UAT keys from the
# Thawani mini-doc / dashboard, or production keys once merchant-approved.
THAWANI_SECRET_KEY=
THAWANI_PUBLISHABLE_KEY=
THAWANI_MODE=uat   # "uat" or "production"
