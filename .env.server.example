# ───────────────────────────────────────────────────────────────
# Server / Docker deployment variables.
#
# Copy this file to `.env` ON THE SERVER (next to docker-compose.yml)
# and fill in real values. docker compose reads it automatically for
# ${VAR} substitution.
#
# NOTE: The project's local `.env` (with DATABASE_URL=localhost) is for
# `npm run dev` only and is NOT copied into the image (see .dockerignore).
# In the container, DATABASE_URL is built from the POSTGRES_* values below.
# ───────────────────────────────────────────────────────────────

# Postgres credentials (used by both the db and the app services)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=haladresses

# Public site URL + name (baked into the build, so rebuild if changed)
NEXT_PUBLIC_APP_URL=https://hala-dresses.com
NEXT_PUBLIC_APP_NAME=Hala Dresses

# Reverse proxy (nginx-proxy + letsencrypt-companion)
VIRTUAL_HOST=hala-dresses.com
LETSENCRYPT_HOST=hala-dresses.com
LETSENCRYPT_EMAIL=admin@hala-dresses.com

# Set to "true" only on the FIRST deploy to seed the admin user
# (admin@haladresses.com / Admin@12345) and demo data. Set back to
# false (or remove) afterwards.
RUN_SEED=false
